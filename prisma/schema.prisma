generator client {
  provider = "prisma-client-js"
  output   = "../lib/db/generated/main"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum BusinessCategory {
  RESTAURANT
  FURNITURE
  ELECTRONICS
}

enum PostType {
  IMAGE
  VIDEO
}

enum UserType {
  VENDOR
  EMPLOYEE
  END_USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum VendorStatus {
  VERIFIED
  UNVERIFIED
}

enum OfferTargetType {
  CATEGORY
  SUBCATEGORY
  ITEM
}

enum OfferType {
  FIXED
  PERCENTAGE
  BUY_GET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum AffiliateStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AffiliateReferralType {
  CUSTOMER
  VENDOR
}

enum AffiliateReferralStatus {
  REGISTERED
  CONVERTED
  REJECTED
}

enum AffiliateCommissionType {
  CUSTOMER_ORDER
  VENDOR_REGISTRATION
  VENDOR_DINE_IN
}

enum AffiliateCommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  CANCELLED
}

enum AffiliateWithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  username      String?   @unique
  bio           String?
  city          String?
  locality      String?
  address       String?
  state         String?
  pincode       String?
  latitude      Float?
  longitude     Float?
  interests     Json      @default("[]")
  userType      UserType  @default(END_USER)
  phoneNumber   String?   @unique
  phoneNumberVerified Boolean @default(false)
  status        AccountStatus @default(ACTIVE)
  onboardingCompleted Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  ownedShops    Shop[]
  follows       Follow[]
  likes         Like[]
  saves         Save[]
  feedInteractions FeedInteraction[]
  feedShares    FeedShare[]
  bills         Bill[]    @relation("BillEndUser")
  affiliate     Affiliate?
  affiliateReferrals AffiliateReferral[] @relation("AffiliateReferredUser")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId             String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                  String?   @db.Text
  password               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model PhoneOtp {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  codeHash    String
  expiresAt   DateTime
  lastSentAt  DateTime @default(now())
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
  @@map("phone_otp")
}

model Shop {
  id         String           @id @default(cuid())
  name       String
  handle     String           @unique
  category   BusinessCategory
  vendorStatus VendorStatus @default(UNVERIFIED)
  status     String
  rating     Float
  initials   String
  image      String
  coverImage String?
  description String?
  businessHours String?
  email      String?
  phone      String?
  payment    Json?
  workingDays Json @default("[]")
  ownerId    String?
  locationId String
  owner      User?            @relation(fields: [ownerId], references: [id])
  location   Location         @relation(fields: [locationId], references: [id])
  posts      Post[]
  products   Product[]
  menuCategories MenuCategory[]
  menuSubCategories MenuSubCategory[]
  offers     Offer[]
  follows    Follow[]
  purchases  Purchase[]
  bills      Bill[]
  affiliateReferrals AffiliateReferral[] @relation("AffiliateReferredShop")

  @@index([category, locationId])
  @@map("shop")
}

model Location {
  id        String   @id @default(cuid())
  address   String
  locality  String
  city      String
  state     String
  pincode   String?
  latitude  Float?
  longitude Float?
  shops     Shop[]

  @@index([city, locality])
  @@map("location")
}

model Post {
  id               String    @id @default(cuid())
  shopId           String
  offerId          String?   @unique
  type             PostType
  postCategory     String?
  title            String
  description      String
  mediaUrl         String
  thumbnailUrl     String?
  altText          String?
  isOfferIncluded  Boolean   @default(false)
  isDownloaded     Boolean   @default(false)
  hashtags         Json      @default("[]")
  publishedAt      DateTime  @default(now())
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  offer            Offer?    @relation(fields: [offerId], references: [id])
  likes            Like[]
  saves            Save[]

  @@index([shopId, publishedAt])
  @@map("post")
}

model Product {
  id          String   @id @default(cuid())
  shopId      String
  name        String
  description String
  priceInr    Float
  imageUrl    String?
  menuCategoryId String?
  menuSubCategoryId String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  menuCategory MenuCategory? @relation(fields: [menuCategoryId], references: [id])
  menuSubCategory MenuSubCategory? @relation(fields: [menuSubCategoryId], references: [id])
  offers      Offer[]

  @@index([shopId, isAvailable])
  @@map("product")
}

model MenuCategory {
  id          String   @id @default(cuid())
  shopId      String
  name        String
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  subCategories MenuSubCategory[]
  products    Product[]

  @@index([shopId, name])
  @@map("menu_category")
}

model MenuSubCategory {
  id             String   @id @default(cuid())
  shopId         String
  categoryId     String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category       MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products       Product[]

  @@index([shopId, categoryId])
  @@map("menu_sub_category")
}

model Offer {
  id             String          @id @default(cuid())
  shopId         String
  targetType     OfferTargetType
  targetId       String
  offerType      OfferType
  offerValue     Json
  validityFrom   DateTime
  validityTo     DateTime
  productId      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id])
    posts          Post[]

  @@index([shopId, validityFrom, validityTo])
  @@index([targetType, targetId])
  @@map("offer")
}

model Follow {
  id         String   @id @default(cuid())
  userId     String
  shopId     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([shopId, createdAt])
  @@map("follow")
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId, createdAt])
  @@map("like")
}

model Save {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId, createdAt])
  @@map("save")
}

// These records also support vendor posts stored in the separate legacy DB,
// whose numeric post IDs cannot be foreign keys to this app's Post table.
model FeedInteraction {
  id         String   @id @default(cuid())
  userId     String
  targetType String   @map("target_type") @db.VarChar(12)
  targetId   String   @map("target_id") @db.VarChar(120)
  action     String   @db.VarChar(12)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId, action])
  @@index([targetType, targetId, action, active])
  @@map("feed_interaction")
}

model FeedShare {
  id         String   @id @default(cuid())
  userId     String
  targetType String   @map("target_type") @db.VarChar(12)
  targetId   String   @map("target_id") @db.VarChar(120)
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId, createdAt])
  @@index([userId, createdAt])
  @@map("feed_share")
}

model Purchase {
  id        String   @id @default(cuid())
  shopId    String
  item      String
  date      String
  totalInr  Int
  status    String
  shop      Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@map("purchase")
}

model Bill {
  id            String        @id @default(cuid())
  shopId        String
  endUserId     String
  products      Json
  totalPriceInr Float         @default(0)
  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  shop          Shop          @relation(fields: [shopId], references: [id])
  endUser       User          @relation("BillEndUser", fields: [endUserId], references: [id])
  affiliateCommissions AffiliateCommission[] @relation("AffiliateCommissionBill")

  @@index([shopId, createdAt])
  @@index([endUserId, createdAt])
  @@map("bill")
}

model Affiliate {
  id            String                   @id @default(cuid())
  userId        String                   @unique
  affiliateCode String                   @unique
  status        AffiliateStatus          @default(ACTIVE)
  withdrawalRevision Int                 @default(0)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals     AffiliateReferral[]
  clicks        AffiliateClick[]
  commissions   AffiliateCommission[]
  withdrawals   AffiliateWithdrawal[]
  bankAccounts  AffiliateBankAccount[]

  @@index([status, createdAt])
  @@map("affiliate")
}

model AffiliateReferral {
  id             String                 @id @default(cuid())
  affiliateId    String
  referralKey    String                 @unique
  referralType   AffiliateReferralType
  referredUserId String?
  referredShopId String?
  status         AffiliateReferralStatus @default(REGISTERED)
  registeredAt   DateTime               @default(now())
  convertedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  affiliate      Affiliate              @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUser   User?                  @relation("AffiliateReferredUser", fields: [referredUserId], references: [id])
  referredShop   Shop?                  @relation("AffiliateReferredShop", fields: [referredShopId], references: [id])
  commissions    AffiliateCommission[]

  @@index([affiliateId, referralType, status, createdAt])
  @@index([referredUserId])
  @@index([referredShopId])
  @@map("affiliate_referral")
}

model AffiliateClick {
  id           String                 @id @default(cuid())
  affiliateId  String
  referralType AffiliateReferralType
  referralCode String
  converted    Boolean                @default(false)
  createdAt    DateTime               @default(now())
  affiliate    Affiliate              @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, createdAt])
  @@index([affiliateId, referralType, converted, createdAt])
  @@map("affiliate_click")
}

model AffiliateCommission {
  id              String                    @id @default(cuid())
  affiliateId     String
  referralId      String
  eventKey        String                    @unique
  commissionType  AffiliateCommissionType
  sourceBillId    String?
  baseAmount      Float
  commissionRate  Float?
  fixedAmount     Float?
  commissionAmount Float
  status          AffiliateCommissionStatus @default(PENDING)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  affiliate       Affiliate                 @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referral        AffiliateReferral         @relation(fields: [referralId], references: [id], onDelete: Cascade)
  sourceBill      Bill?                     @relation("AffiliateCommissionBill", fields: [sourceBillId], references: [id])

  @@index([affiliateId, status, createdAt])
  @@index([referralId, createdAt])
  @@index([sourceBillId])
  @@map("affiliate_commission")
}

model AffiliateWithdrawal {
  id            String                   @id @default(cuid())
  affiliateId   String
  requestKey    String                   @unique
  amount        Float
  paymentMethod String                   @default("BANK_TRANSFER")
  bankAccountId String?
  status        AffiliateWithdrawalStatus @default(PENDING)
  requestedAt   DateTime                 @default(now())
  processedAt   DateTime?
  referenceCode String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  affiliate     Affiliate                @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  bankAccount   AffiliateBankAccount?    @relation(fields: [bankAccountId], references: [id])

  @@index([affiliateId, status, requestedAt])
  @@map("affiliate_withdrawal")
}

model AffiliateBankAccount {
  id                String               @id @default(cuid())
  affiliateId       String
  accountHolderName String
  bankName          String
  branchName        String?
  accountLast4      String
  ifscCode          String
  upiId             String?
  verified          Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  affiliate         Affiliate            @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  withdrawals       AffiliateWithdrawal[]

  @@index([affiliateId, createdAt])
  @@map("affiliate_bank_account")
}

// Legacy vendor-app tables share the same MySQL service as the main app.
// Keeping them in this schema lets both sets of models use one Prisma pool.
model SharedUser {
  id          Int       @id @default(autoincrement())
  phoneNumber String    @map("phone_number") @db.VarChar(15)
  userType    String    @map("user_type") @db.VarChar(20)
  status      String    @db.VarChar(20)
  createdAt   DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(0)
  vendors     SharedVendor[]
  bills       SharedBill[]
  walkins     SharedWalkin[]

  @@map("users")
}

model SharedVendor {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  businessName      String?   @map("business_name") @db.VarChar(255)
  status            String    @db.VarChar(20)
  logoUrl           String?   @map("logo_url") @db.Text
  businessCategory String?   @map("business_category") @db.VarChar(255)
  address           String?   @db.Text
  payment           Json?
  workingDays       Json?     @map("working_days")
  createdAt         DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime? @map("updated_at") @db.Timestamp(0)
  user              SharedUser @relation(fields: [userId], references: [id])
  posts             SharedPost[]
  menuCategories    SharedMenuCategory[]
  menuSubCategories SharedMenuSubCategory[]
  menuItems         SharedMenuItem[]
  offers            SharedOffer[]
  bills             SharedBill[]
  walkins           SharedWalkin[]

  @@unique([userId])
  @@index([userId])
  @@map("vendors")
}

model SharedPost {
  id              Int       @id @default(autoincrement())
  vendorId        Int       @map("vendor_id")
  postType        String    @map("post_type") @db.VarChar(20)
  postCategory    String?   @map("post_category") @db.VarChar(255)
  postUrl         String    @map("post_url") @db.Text
  isOfferIncluded Boolean   @default(false) @map("is_offer_included")
  offerId         Int?      @map("offer_id")
  isDownloaded    Boolean   @default(false) @map("is_downloaded")
  createdAt       DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime? @map("updated_at") @db.Timestamp(0)
  vendor          SharedVendor @relation(fields: [vendorId], references: [id])
  offer           SharedOffer? @relation(fields: [offerId], references: [id])

  @@index([vendorId])
  @@index([offerId])
  @@map("posts")
}

model SharedMenuCategory {
  id            Int       @id @default(autoincrement())
  vendorId      Int       @map("vendor_id")
  categoryName  String    @map("category_name") @db.VarChar(255)
  categoryImage String?   @map("category_image") @db.Text
  createdAt     DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(0)
  vendor        SharedVendor @relation(fields: [vendorId], references: [id])
  subCategories SharedMenuSubCategory[]
  items         SharedMenuItem[]

  @@index([vendorId])
  @@map("menu_categories")
}

model SharedMenuSubCategory {
  id              Int       @id @default(autoincrement())
  vendorId        Int       @map("vendor_id")
  categoryId      Int       @map("category_id")
  subCategoryName String    @map("sub_category_name") @db.VarChar(255)
  createdAt       DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime? @map("updated_at") @db.Timestamp(0)
  vendor          SharedVendor @relation(fields: [vendorId], references: [id])
  category        SharedMenuCategory @relation(fields: [categoryId], references: [id])
  items           SharedMenuItem[]

  @@index([vendorId])
  @@index([categoryId])
  @@map("menu_sub_categories")
}

model SharedMenuItem {
  id                Int       @id @default(autoincrement())
  vendorId          Int       @map("vendor_id")
  menuCategoryId    Int       @map("menu_category_id")
  menuSubCategoryId Int?      @map("menu_sub_category_id")
  productName       String    @map("product_name") @db.VarChar(255)
  image             String?   @db.Text
  price             Decimal   @db.Decimal(10, 2)
  createdAt         DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime? @map("updated_at") @db.Timestamp(0)
  vendor            SharedVendor @relation(fields: [vendorId], references: [id])
  category          SharedMenuCategory @relation(fields: [menuCategoryId], references: [id])
  subCategory       SharedMenuSubCategory? @relation(fields: [menuSubCategoryId], references: [id])

  @@index([vendorId])
  @@index([menuCategoryId])
  @@index([menuSubCategoryId])
  @@map("menu_items")
}

model SharedOffer {
  id              Int       @id @default(autoincrement())
  vendorId        Int       @map("vendor_id")
  offerTargetType String?   @map("offer_target_type") @db.VarChar(20)
  offerTargetId   Int?      @map("offer_target_id")
  offerType       String    @map("offer_type") @db.VarChar(20)
  offerValue      Json?     @map("offer_value")
  validityFrom    DateTime? @map("validity_from")
  validityTo      DateTime? @map("validity_to")
  createdAt       DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime? @map("updated_at") @db.Timestamp(0)
  vendor          SharedVendor @relation(fields: [vendorId], references: [id])
  posts           SharedPost[]

  @@index([vendorId])
  @@map("offers")
}

model SharedBill {
  id            Int       @id @default(autoincrement())
  vendorId      Int       @map("vendor_id")
  endUserId     Int?      @map("end_user_id")
  products      Json
  totalPrice    Decimal   @default(0) @map("total_price") @db.Decimal(10, 2)
  paymentStatus String    @default("paid") @map("payment_status") @db.VarChar(20)
  createdAt     DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(0)
  vendor        SharedVendor @relation(fields: [vendorId], references: [id])
  endUser       SharedUser? @relation(fields: [endUserId], references: [id])

  @@index([vendorId])
  @@index([endUserId])
  @@map("bills")
}

model SharedWalkin {
  id              Int       @id @default(autoincrement())
  vendorId        Int       @map("vendor_id")
  endUserId       Int?      @map("end_user_id")
  appUserId       String    @map("app_user_id") @db.VarChar(64)
  latitude        Decimal   @db.Decimal(10, 7)
  longitude       Decimal   @db.Decimal(10, 7)
  distanceMeters  Int       @map("distance_meters")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  vendor          SharedVendor @relation(fields: [vendorId], references: [id])
  endUser         SharedUser? @relation(fields: [endUserId], references: [id], onDelete: SetNull)

  @@index([vendorId, createdAt])
  @@index([appUserId, vendorId, createdAt])
  @@index([endUserId])
  @@map("walkins")
}
